# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored; never commit real values.

# --- Shopify Storefront API (headless) ---
# Create a custom app in your Shopify admin (Settings > Apps and sales channels
# > Develop apps) and enable the Storefront API scopes you need.

# Store hostname only, no https://
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API *public* access token. It is designed to be safe in the
# browser, but keep it out of git anyway so it can be rotated independently.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-public-access-token

# Optional: Storefront API version (default 2025-01)
# SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Optional: public store hostname used for checkout links if it differs
# from SHOPIFY_STORE_DOMAIN
# NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# --- Site ---
# Optional: public origin of the deployed site, used for metadata, robots and
# the sitemap (default https://lionleather.pk)
# NEXT_PUBLIC_SITE_URL=https://example.com
